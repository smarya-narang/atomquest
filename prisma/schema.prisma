generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("EMPLOYEE") // EMPLOYEE, MANAGER, ADMIN
  managerId String?
  manager   User?    @relation("ManagerToEmployee", fields: [managerId], references: [id])
  employees User[]   @relation("ManagerToEmployee")
  goals     Goal[]
}

model Goal {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  thrustArea  String
  title       String
  description String?
  uom         String   // Numeric, Percentage, Timeline, Zero-based
  target      Float
  weightage   Float
  status      String   @default("DRAFT") // DRAFT, PENDING, APPROVED, RETURNED
  isShared    Boolean  @default(false)
  checkIns    CheckIn[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CheckIn {
  id                String   @id @default(cuid())
  goalId            String
  goal              Goal     @relation(fields: [goalId], references: [id])
  quarter           String   // Q1, Q2, Q3, Q4
  actualAchievement Float
  status            String   // Not Started, On Track, Completed
  managerComment    String?
  date              DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  userId      String
  details     String
  timestamp   DateTime @default(now())
}
